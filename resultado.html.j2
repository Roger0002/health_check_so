{% macro render_status(status_val) %}
  {% if status_val == 'OK' %}
    <span class="status-badge OK"><span class="status-dot OK"></span> OK</span>
  {% elif status_val == 'FAIL' %}
    <span class="status-badge FAIL"><span class="status-dot FAIL"></span> FAIL</span>
  {% elif status_val == 'PARTIAL' %}
    <span class="status-badge PARTIAL"><span class="status-dot PARTIAL"></span> PARTIAL</span>
  {% else %}
    <span class="status-badge INFO"><span class="status-dot INFO"></span> {{ status_val }}</span>
  {% endif %}
{% endmacro %}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Health Check Linux - Relatório Executivo</title>

  <!-- Fontes Oficiais Red Hat da CDN -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@400;500;700;800&family=Red+Hat+Mono:wght@400;500&family=Red+Hat+Text:wght@400;500;700&display=swap" rel="stylesheet">

  <style>
    :root {
      /* PF6 Font Stacks */
      --font-body: "Red Hat Text", Helvetica, Arial, sans-serif;
      --font-heading: "Red Hat Display", Helvetica, Arial, sans-serif;
      --font-mono: "Red Hat Mono", "Courier New", Courier, monospace;

      /* PF6 Status Colors (Compiled Tokens) */
      --color-in-use: #3d7317; 
      --color-not-found: #b1380b;
      --color-partial: #f0ab00; 
      --color-info: #5e40be;

      --bg-in-use: #e9f7df; 
      --bg-not-found: #ffe3d9;
      --bg-partial: #fff4cc; 
      --bg-info: #ece6ff;

      /* PF6 Brand & Chrome */
      --rh-red: #ee0000; 
      --rh-dark: #1f1f1f; 
      --border: #c7c7c7;
      --bg-page: #f2f2f2; 
      --bg-card: #ffffff;
      --text-primary: #151515; 
      --text-secondary: #4d4d4d;

      /* PF6 Typography Scale */
      --fs-xs: 0.75rem; 
      --fs-sm: 0.875rem; 
      --fs-md: 1rem;
      --fs-lg: 1.125rem; 
      --fs-xl: 1.25rem; 
      --fs-2xl: 1.375rem;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { 
      font-family: var(--font-body); 
      font-size: var(--fs-sm); 
      background: var(--bg-page); 
      color: var(--text-primary); 
      line-height: 1.5; 
    }
    h1, h2, h3, h4, h5, h6 { font-family: var(--font-heading); }
    code, pre { font-family: var(--font-mono); }

    /* Sticky Header & Meta Bar */
    .sticky-header { position: sticky; top: 0; z-index: 100; }
    .header { 
      background: linear-gradient(135deg, var(--rh-dark) 0%, #292929 100%); 
      color: white; 
      padding: 1.25rem 2.5rem 1rem; 
      border-bottom: 4px solid var(--rh-red); 
    }
    .header h1 { font-size: var(--fs-2xl); font-weight: 700; margin-bottom: .25rem; }
    .header .subtitle { color: #a3a3a3; font-size: var(--fs-sm); }

    .meta-bar { 
      display: flex; 
      flex-wrap: wrap; 
      gap: 1.5rem; 
      padding: 0.85rem 2.5rem; 
      background: var(--bg-card); 
      border-bottom: 1px solid var(--border); 
      font-size: var(--fs-sm); 
    }
    .meta-item { display: flex; gap: .4rem; } 
    .meta-item .label { color: var(--text-secondary); } 
    .meta-item .value { font-weight: 600; }

    /* Layout Containers */
    .container { 
      max-width: 98vw; 
      width: 90%; 
      min-width: 900px; 
      margin: 0 auto; 
      padding: 1.5rem 1.5rem 3rem; 
    }

    .stage-section { 
      background: var(--bg-card); 
      border: 1px solid var(--border); 
      border-radius: 12px; 
      margin-bottom: 1.5rem; 
      overflow: hidden; 
    }
    .stage-header-block { 
      background: var(--bg-page); 
      border-bottom: 1px solid var(--border); 
      padding: 1rem 1.5rem; 
    }
    .stage-header h2 { font-size: var(--fs-lg); font-weight: 700; }

    /* Tables Style */
    .items-table { width: 100%; border-collapse: collapse; }
    .items-table th { 
      text-align: left; 
      padding: .75rem 1rem; 
      font-size: var(--fs-xs); 
      text-transform: uppercase; 
      letter-spacing: .05em; 
      color: var(--text-secondary); 
      background: var(--bg-page); 
      border-bottom: 1px solid var(--border); 
    }
    .items-table td { 
      padding: .75rem 1rem; 
      border-bottom: 1px solid #e0e0e0; 
      font-size: var(--fs-sm); 
      vertical-align: middle; 
    }
    .items-table tr:last-child td { border-bottom: none; } 
    .items-table tr:hover td { background: var(--bg-page); }

    /* Status Badges com Pontos Coloridos (Conforme modelo OCP) */
    .status-badge { 
      display: inline-flex; 
      align-items: center; 
      gap: .35rem; 
      padding: .2rem .7rem; 
      border-radius: 999px; 
      font-size: var(--fs-xs); 
      font-weight: 600; 
      white-space: nowrap; 
    }
    .status-badge.OK { background: var(--bg-in-use); color: #204d00; }
    .status-badge.FAIL { background: var(--bg-not-found); color: #731f00; }
    .status-badge.PARTIAL { background: var(--bg-partial); color: #73480b; }
    .status-badge.INFO { background: var(--bg-info); color: #21134d; }

    .status-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
    .status-dot.OK { background: var(--color-in-use); }
    .status-dot.FAIL { background: var(--color-not-found); }
    .status-dot.PARTIAL { background: var(--color-partial); }
    .status-dot.INFO { background: var(--color-info); }

    /* Grids & Terminal Blocks */
    .detail-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
    .detail-item { padding: .1rem 0; }
    .detail-item strong { display: block; margin-bottom: .25rem; color: var(--text-primary); }
    .detail-item.full-width { grid-column: 1 / -1; }

    pre.terminal-box {
      background-color: var(--rh-dark);
      color: #00ff66;
      padding: 0.75rem 1rem;
      border-radius: 6px;
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      white-space: pre-wrap;
      word-break: break-all;
      margin-top: .25rem;
      border: 1px solid #333;
    }

    .footer { text-align: center; padding: 2rem; color: var(--text-secondary); font-size: var(--fs-xs); }
    
    @media (max-width: 768px) {
      .detail-grid { grid-template-columns: 1fr; }
      .container { min-width: 100%; width: 100%; padding: 1rem; }
    }
  </style>
</head>
<body>

  <!-- Header Fixo & Barra de Metadados -->
  <div class="sticky-header">
    <div class="header">
      <h1>Health Check Linux</h1>
      <div class="subtitle">Relatório Gerencial e Técnico de Infraestrutura</div>
    </div>
    <div class="meta-bar">
      <div class="meta-item"><span class="label">Hostname:</span><span class="value">{{ ansible_facts['fqdn'] }}</span></div>
      <div class="meta-item"><span class="label">Sistema Operacional:</span><span class="value">{{ ansible_facts['distribution'] }} {{ ansible_facts['distribution_version'] }}</span></div>
      <div class="meta-item"><span class="label">Versão do Kernel:</span><span class="value">{{ ansible_facts['kernel'] }}</span></div>
      <div class="meta-item"><span class="label">Endereços IPv4:</span><span class="value">{% for item in ansible_facts['all_ipv4_addresses'] %}{{ item }}{% if not loop.last %}, {% endif %}{% endfor %}</span></div>
    </div>
  </div>

  <div class="container">

    <!-- Seção de Coletas do Servidor -->
    <div class="stage-section">
      <div class="stage-header-block">
        <div class="stage-header">
          <h2>Informações do Servidor & Coletas</h2>
        </div>
      </div>
      <div style="padding: 1.25rem;">
        <div class="detail-grid">
          <div class="detail-item">
            <strong>Uptime & Load Average</strong>
            <pre class="terminal-box">{{ saida_uptime.stdout }}</pre>
          </div>
          <div class="detail-item">
            <strong>Situação Perfil Tuned</strong>
            <pre class="terminal-box">{{ saida_perfiltuned.stdout | default("Sem tuned ativo") }}</pre>
          </div>
          <div class="detail-item full-width">
            <strong>Consumo de Banda nas Interfaces</strong>
            <pre class="terminal-box">{{ saida_script_consumo_interfaces.stdout }}</pre>
          </div>
        </div>
      </div>
    </div>

    <!-- Seção: Autenticação -->
    <div class="stage-section">
      <div class="stage-header-block">
        <div class="stage-header"><h2>Autenticação</h2></div>
      </div>
      <table class="items-table">
        <thead><tr><th style="width:5%">#</th><th style="width:65%">Item de Verificação</th><th style="width:30%">Status</th></tr></thead>
        <tbody>
          <tr><td>1</td><td>NSSwitch</td><td>{{ render_status(teste_nsswitch) }}</td></tr>
          <tr><td>2</td><td>Conectividade LDAP</td><td>{{ render_status(teste_ldap) }}</td></tr>
          <tr><td>3</td><td>Daemon SSSD</td><td>{{ render_status(teste_sssd) }}</td></tr>
        </tbody>
      </table>
    </div>

    <!-- Seção: Acesso a Conteúdo -->
    <div class="stage-section">
      <div class="stage-header-block">
        <div class="stage-header"><h2>Acesso a Conteúdo</h2></div>
      </div>
      <table class="items-table">
        <thead><tr><th style="width:5%">#</th><th style="width:65%">Item de Verificação</th><th style="width:30%">Status</th></tr></thead>
        <tbody>
          <tr><td>1</td><td>Repositórios padrão</td><td>{{ render_status(teste_repodefaults) }}</td></tr>
          <tr><td>2</td><td>Download de pacotes</td><td>{{ render_status(teste_downloadpackages) }}</td></tr>
          <tr><td>3</td><td>Registro no Insights</td><td>{{ render_status(teste_registroinsights) }}</td></tr>
        </tbody>
      </table>
    </div>

    <!-- Seção: Logging -->
    <div class="stage-section">
      <div class="stage-header-block">
        <div class="stage-header"><h2>Logging</h2></div>
      </div>
      <table class="items-table">
        <thead><tr><th style="width:5%">#</th><th style="width:65%">Item de Verificação</th><th style="width:30%">Status</th></tr></thead>
        <tbody>
          <tr><td>1</td><td>Daemon rsyslog</td><td>{{ render_status(teste_rsyslog) }}</td></tr>
          <tr><td>2</td><td>Escrita nos logs</td><td>{{ render_status(teste_escritalogs) }}</td></tr>
        </tbody>
      </table>
    </div>

    <!-- Seção: Segurança -->
    <div class="stage-section">
      <div class="stage-header-block">
        <div class="stage-header"><h2>Segurança</h2></div>
      </div>
      <table class="items-table">
        <thead><tr><th style="width:5%">#</th><th style="width:65%">Item de Verificação</th><th style="width:30%">Status</th></tr></thead>
        <tbody>
          <tr><td>1</td><td>Bugs</td><td>{{ render_status(teste_bugs) }}</td></tr>
          <tr><td>2</td><td>Falhas de Segurança</td><td>{{ render_status(teste_falhaseguranca) }}</td></tr>
          <tr><td>3</td><td>Audit</td><td>{{ render_status(teste_audit) }}</td></tr>
          <tr><td>4</td><td>SELinux</td><td>{{ render_status(teste_selinux) }}</td></tr>
          <tr><td>5</td><td>Violações SELinux</td><td>{{ render_status(teste_selinuxviolations) }}</td></tr>
          <tr><td>6</td><td>Firewalld</td><td>{{ render_status(teste_firewalld) }}</td></tr>
        </tbody>
      </table>
    </div>

    <!-- Seção: Rede -->
    <div class="stage-section">
      <div class="stage-header-block">
        <div class="stage-header"><h2>Rede</h2></div>
      </div>
      <table class="items-table">
        <thead><tr><th style="width:5%">#</th><th style="width:65%">Item de Verificação</th><th style="width:30%">Status</th></tr></thead>
        <tbody>
          <tr><td>1</td><td>DNS Externo</td><td>{{ render_status(teste_resolucaodnsexterno) }}</td></tr>
          <tr><td>2</td><td>Hostname em /etc/hosts</td><td>{{ render_status(teste_etchosts) }}</td></tr>
          <tr><td>3</td><td>Pacotes com erro</td><td>{{ render_status(teste_txrx) }}</td></tr>
          <tr><td>4</td><td>Sincronismo NTP</td><td>{{ render_status(teste_ntp) }}</td></tr>
        </tbody>
      </table>
    </div>

    <!-- Seção: LVM -->
    <div class="stage-section">
      <div class="stage-header-block">
        <div class="stage-header"><h2>LVM</h2></div>
      </div>
      <table class="items-table">
        <thead><tr><th style="width:5%">#</th><th style="width:65%">Item de Verificação</th><th style="width:30%">Status</th></tr></thead>
        <tbody>
          <tr><td>1</td><td>Metadados dos VGs</td><td>{{ render_status(teste_metadados) }}</td></tr>
          <tr><td>2</td><td>Comando pvs</td><td>{{ render_status(teste_errocomandopvs) }}</td></tr>
          <tr><td>3</td><td>Backup de Metadados</td><td>{{ render_status(teste_backupmetadados) }}</td></tr>
        </tbody>
      </table>
    </div>

    <!-- Seção: Miscelânea -->
    <div class="stage-section">
      <div class="stage-header-block">
        <div class="stage-header"><h2>Miscelânea</h2></div>
      </div>
      <table class="items-table">
        <thead><tr><th style="width:5%">#</th><th style="width:65%">Item de Verificação</th><th style="width:30%">Status</th></tr></thead>
        <tbody>
          <tr><td>1</td><td>Coleta de recursos</td><td>{{ render_status(teste_sar) }}</td></tr>
          <tr><td>2</td><td>Integridade RPM</td><td>{{ render_status(teste_baserpm) }}</td></tr>
          <tr><td>3</td><td>Necessidade de reboot</td><td>{{ render_status(teste_rebootrequerido) }}</td></tr>
          <tr><td>4</td><td>/usr não apartado</td><td>{{ render_status(teste_usrnaoapartado) }}</td></tr>
          <tr><td>5</td><td>Kdump</td><td>{{ render_status(teste_kdump) }}</td></tr>
        </tbody>
      </table>
    </div>

    <!-- Seção Condicional de Logs de Erro -->
    {% if coleta_logs_on %}
    <div class="stage-section">
      <div class="stage-header-block">
        <div class="stage-header"><h2>Presença da string "error" nos principais logs</h2></div>
      </div>
      <div style="padding: 1.25rem;">
        <pre class="terminal-box">{{ saida_errologs.stdout }}
{{ saida_errojournal.stdout }}</pre>
      </div>
    </div>
    {% endif %}

  </div>

  <div class="footer">
    Health Check Linux Framework &mdash; Relatório Gerencial
  </div>

</body>
</html>
